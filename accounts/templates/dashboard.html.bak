{% load static %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}VaultShare Workspace{% endblock %}</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <!-- Central Design System CSS -->
    <link rel="stylesheet" href="{% static 'style.css' %}">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet" />

    {% block extra_css %}{% endblock %}
</head>

<body class="text-light" style="background-color: var(--vs-bg-dark);">

<a href="#main-content" class="visually-hidden-focusable btn btn-info position-absolute top-0 start-0 m-2 z-3">
    Skip to main content
</a>

<div class="container-fluid p-0 min-vh-100">
<div class="row g-0 min-vh-100">

    <!-- ================= DESKTOP SIDEBAR ================= -->
    <nav class="col-lg-2 d-none d-lg-flex flex-column sticky-top vh-100 p-0 border-end border-secondary border-opacity-25"
         style="background: #040711; z-index: 1040;"
         aria-label="Primary navigation">

        <!-- Sidebar Brand Header -->
        <div class="p-3 border-bottom border-secondary border-opacity-25 text-center">
            <a href="{% url 'home' %}" class="text-decoration-none d-flex align-items-center justify-content-center gap-2">
                <div class="d-inline-flex align-items-center justify-content-center rounded-3 bg-info bg-opacity-10 border border-info border-opacity-30 p-2" style="width: 36px; height: 36px;">
                    <i class="bi bi-shield-lock-fill text-info fs-5"></i>
                </div>
                <div class="text-start">
                    <div class="fw-bold font-heading text-white tracking-tight lh-1" style="font-size: 1.15rem;">
                        Vault<span class="text-info">Share</span>
                    </div>
                    <small class="text-secondary font-mono" style="font-size: 0.62rem; letter-spacing: 0.05em;">SECURE VAULT v2.4</small>
                </div>
            </a>
        </div>

        <!-- Sidebar Navigation Items -->
        <div class="list-group list-group-flush flex-grow-1 overflow-auto p-2 font-mono small">

            {% if request.user.is_superuser %}
            <!-- ADMIN MENU -->
            <small class="text-secondary text-uppercase fw-semibold px-3 pt-3 pb-1 d-block" style="font-size: 0.65rem; letter-spacing:.08em;">Administration</small>

            <a href="{% url 'user_dashboard' %}"
               class="list-group-item list-group-item-action {% if request.resolver_match.url_name == 'user_dashboard' %}vs-nav-active{% else %}bg-transparent text-light hover-bg-opacity{% endif %} border-0 rounded-2 py-2 mb-1">
                <i class="bi bi-speedometer2 me-2.5 text-info"></i>Dashboard
            </a>

            <a href="{% url 'myfiles' %}"
               class="list-group-item list-group-item-action {% if request.resolver_match.url_name == 'myfiles' %}vs-nav-active{% else %}bg-transparent text-light hover-bg-opacity{% endif %} border-0 rounded-2 py-2 mb-1">
                <i class="bi bi-folder-fill me-2.5 text-warning"></i>All Files
            </a>

            <a href="{% url 'shared_history' %}"
               class="list-group-item list-group-item-action {% if request.resolver_match.url_name == 'shared_history' %}vs-nav-active{% else %}bg-transparent text-light hover-bg-opacity{% endif %} border-0 rounded-2 py-2 mb-1">
                <i class="bi bi-share-fill me-2.5 text-info"></i>Shared Files
            </a>

            <a href="{% url 'audit-trail' %}"
               class="list-group-item list-group-item-action {% if request.resolver_match.url_name == 'audit-trail' %}vs-nav-active{% else %}bg-transparent text-light hover-bg-opacity{% endif %} border-0 rounded-2 py-2 mb-1">
                <i class="bi bi-clock-history me-2.5 text-success"></i>Activity Logs
            </a>

            <a href="{% url 'edit_profile' %}"
               class="list-group-item list-group-item-action {% if request.resolver_match.url_name == 'edit_profile' %}vs-nav-active{% else %}bg-transparent text-light hover-bg-opacity{% endif %} border-0 rounded-2 py-2 mb-1">
                <i class="bi bi-gear-fill me-2.5 text-secondary"></i>Settings
            </a>

            {% else %}
            <!-- USER MENU -->
            <small class="text-secondary text-uppercase fw-semibold px-3 pt-3 pb-1 d-block" style="font-size: 0.65rem; letter-spacing:.08em;">Vault Controls</small>

            <a href="{% url 'user_dashboard' %}"
               class="list-group-item list-group-item-action {% if request.resolver_match.url_name == 'user_dashboard' %}vs-nav-active{% else %}bg-transparent text-light{% endif %} border-0 rounded-2 py-2 mb-1">
                <i class="bi bi-speedometer2 me-2.5 text-info"></i>Dashboard
            </a>

            <a href="{% url 'myfiles' %}"
               class="list-group-item list-group-item-action {% if request.resolver_match.url_name == 'myfiles' %}vs-nav-active{% else %}bg-transparent text-light{% endif %} border-0 rounded-2 py-2 mb-1">
                <i class="bi bi-folder-fill me-2.5 text-warning"></i>My Files
            </a>

            <a href="{% url 'my_folders' %}"
               class="list-group-item list-group-item-action {% if request.resolver_match.url_name == 'my_folders' or request.resolver_match.url_name == 'folder_detail' %}vs-nav-active{% else %}bg-transparent text-light{% endif %} border-0 rounded-2 py-2 mb-1">
                <i class="bi bi-folder2-open me-2.5 text-warning"></i>My Folders
            </a>

            <a href="{% url 'shared_history' %}"
               class="list-group-item list-group-item-action {% if request.resolver_match.url_name == 'shared_history' %}vs-nav-active{% else %}bg-transparent text-light{% endif %} border-0 rounded-2 py-2 mb-1">
                <i class="bi bi-share-fill me-2.5 text-info"></i>Shared Files
            </a>

            <a href="{% url 'received_files' %}"
               class="list-group-item list-group-item-action {% if request.resolver_match.url_name == 'received_files' %}vs-nav-active{% else %}bg-transparent text-light{% endif %} border-0 rounded-2 py-2 mb-1">
                <i class="bi bi-download me-2.5 text-success"></i>Received Files
            </a>

            <a href="{% url 'access_requests' %}"
               class="list-group-item list-group-item-action {% if request.resolver_match.url_name == 'access_requests' %}vs-nav-active{% else %}bg-transparent text-light{% endif %} border-0 rounded-2 py-2 mb-1">
                <i class="bi bi-person-lock me-2.5 text-purple"></i>Access Requests
            </a>

            <a href="{% url 'audit-trail' %}"
               class="list-group-item list-group-item-action {% if request.resolver_match.url_name == 'audit-trail' %}vs-nav-active{% else %}bg-transparent text-light{% endif %} border-0 rounded-2 py-2 mb-1">
                <i class="bi bi-clock-history me-2.5 text-success"></i>Activity Audit
            </a>
            <a href="{% url 'security_ai:security_dashboard' %}"
               class="list-group-item list-group-item-action {% if request.resolver_match.url_name == 'security_dashboard' or request.resolver_match.url_name == 'incident_detail' %}vs-nav-active{% else %}bg-transparent text-light{% endif %} border-0 rounded-2 py-2 mb-1">
                <i class="bi bi-shield-lock-fill me-2.5 text-info"></i>Security AI
            </a>

            <small class="text-secondary text-uppercase fw-semibold px-3 pt-3 pb-1 d-block" style="font-size: 0.65rem; letter-spacing:.08em;">Account Settings</small>

            <a href="{% url 'profile' %}"
               class="list-group-item list-group-item-action {% if request.resolver_match.url_name == 'profile' %}vs-nav-active{% else %}bg-transparent text-light{% endif %} border-0 rounded-2 py-2 mb-1">
                <i class="bi bi-person-circle me-2.5 text-info"></i>Profile
            </a>

            <a href="{% url 'edit_profile' %}"
               class="list-group-item list-group-item-action {% if request.resolver_match.url_name == 'edit_profile' %}vs-nav-active{% else %}bg-transparent text-light{% endif %} border-0 rounded-2 py-2 mb-1">
                <i class="bi bi-gear-fill me-2.5 text-secondary"></i>Settings
            </a>
            {% endif %}

        </div>

        <!-- Sidebar Footer Sign Out -->
        <div class="border-top border-secondary border-opacity-25 p-2 mt-auto">
            <a href="{% url 'logout' %}" class="list-group-item list-group-item-action bg-transparent text-danger border-0 rounded-2 py-2 font-mono small d-flex align-items-center">
                <i class="bi bi-box-arrow-right me-2"></i>Sign Out
            </a>
        </div>
    </nav>

    <!-- ================= MOBILE OFFCANVAS DRAWER ================= -->
    <div class="offcanvas offcanvas-start text-white bg-dark d-lg-none" tabindex="-1" id="sidebarOffcanvas"
         aria-labelledby="sidebarOffcanvasLabel" style="background: #040711 !important;">
        <div class="offcanvas-header border-bottom border-secondary border-opacity-25">
            <div class="d-flex align-items-center gap-2">
                <div class="d-inline-flex align-items-center justify-content-center rounded-3 bg-info bg-opacity-10 border border-info border-opacity-30 p-2">
                    <i class="bi bi-shield-lock-fill text-info fs-5"></i>
                </div>
                <div>
                    <h6 class="fw-bold mb-0 font-heading text-white" id="sidebarOffcanvasLabel">Vault<span class="text-info">Share</span></h6>
                    <small class="text-secondary font-mono" style="font-size: 0.7rem;">Encrypted File Sharing</small>
                </div>
            </div>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close menu"></button>
        </div>

        <div class="offcanvas-body p-0 d-flex flex-column font-mono small">
            <nav class="list-group list-group-flush flex-grow-1 overflow-auto p-2" aria-label="Mobile Navigation">

                {% if request.user.is_superuser %}
                <small class="text-secondary text-uppercase fw-semibold px-3 pt-2 pb-1 d-block" style="font-size: 0.65rem;">Administration</small>
                <a href="{% url 'user_dashboard' %}" class="list-group-item list-group-item-action bg-transparent text-light border-0 py-2 mb-1" data-bs-dismiss="offcanvas"><i class="bi bi-speedometer2 me-2 text-info"></i>Dashboard</a>
                <a href="{% url 'myfiles' %}" class="list-group-item list-group-item-action bg-transparent text-light border-0 py-2 mb-1" data-bs-dismiss="offcanvas"><i class="bi bi-folder-fill me-2 text-warning"></i>All Files</a>
                <a href="{% url 'shared_history' %}" class="list-group-item list-group-item-action bg-transparent text-light border-0 py-2 mb-1" data-bs-dismiss="offcanvas"><i class="bi bi-share-fill me-2 text-info"></i>Shared Files</a>
                <a href="{% url 'audit-trail' %}" class="list-group-item list-group-item-action bg-transparent text-light border-0 py-2 mb-1" data-bs-dismiss="offcanvas"><i class="bi bi-clock-history me-2 text-success"></i>Activity Logs</a>
                <a href="{% url 'edit_profile' %}" class="list-group-item list-group-item-action bg-transparent text-light border-0 py-2 mb-1" data-bs-dismiss="offcanvas"><i class="bi bi-gear-fill me-2 text-secondary"></i>Settings</a>
                {% else %}
                <small class="text-secondary text-uppercase fw-semibold px-3 pt-2 pb-1 d-block" style="font-size: 0.65rem;">Vault Controls</small>
                <a href="{% url 'user_dashboard' %}" class="list-group-item list-group-item-action bg-transparent text-light border-0 py-2 mb-1" data-bs-dismiss="offcanvas"><i class="bi bi-speedometer2 me-2 text-info"></i>Dashboard</a>
                <a href="{% url 'myfiles' %}" class="list-group-item list-group-item-action bg-transparent text-light border-0 py-2 mb-1" data-bs-dismiss="offcanvas"><i class="bi bi-folder-fill me-2 text-warning"></i>My Files</a>
                <a href="{% url 'my_folders' %}" class="list-group-item list-group-item-action bg-transparent text-light border-0 py-2 mb-1" data-bs-dismiss="offcanvas"><i class="bi bi-folder2-open me-2 text-warning"></i>My Folders</a>
                <a href="{% url 'shared_history' %}" class="list-group-item list-group-item-action bg-transparent text-light border-0 py-2 mb-1" data-bs-dismiss="offcanvas"><i class="bi bi-share-fill me-2 text-info"></i>Shared Files</a>
                <a href="{% url 'received_files' %}" class="list-group-item list-group-item-action bg-transparent text-light border-0 py-2 mb-1" data-bs-dismiss="offcanvas"><i class="bi bi-download me-2 text-success"></i>Received Files</a>
                <a href="{% url 'access_requests' %}" class="list-group-item list-group-item-action bg-transparent text-light border-0 py-2 mb-1" data-bs-dismiss="offcanvas"><i class="bi bi-person-lock me-2 text-purple"></i>Access Requests</a>
                <a href="{% url 'audit-trail' %}" class="list-group-item list-group-item-action bg-transparent text-light border-0 py-2 mb-1" data-bs-dismiss="offcanvas"><i class="bi bi-clock-history me-2 text-success"></i>Activity Audit</a>

                <small class="text-secondary text-uppercase fw-semibold px-3 pt-3 pb-1 d-block" style="font-size: 0.65rem;">Account</small>
                <a href="{% url 'profile' %}" class="list-group-item list-group-item-action bg-transparent text-light border-0 py-2 mb-1" data-bs-dismiss="offcanvas"><i class="bi bi-person-circle me-2 text-info"></i>Profile</a>
                <a href="{% url 'edit_profile' %}" class="list-group-item list-group-item-action bg-transparent text-light border-0 py-2 mb-1" data-bs-dismiss="offcanvas"><i class="bi bi-gear-fill me-2 text-secondary"></i>Settings</a>
                {% endif %}

            </nav>
            <div class="border-top border-secondary border-opacity-25 p-2">
                <a href="{% url 'logout' %}" class="list-group-item list-group-item-action bg-transparent text-danger border-0 py-2">
                    <i class="bi bi-box-arrow-right me-2"></i>Sign Out
                </a>
            </div>
        </div>
    </div>

    <!-- ================= MAIN CONTENT CONTAINER ================= -->
    <div class="col-lg-10 d-flex flex-column min-vh-100 p-0">

        <!-- Top Header Bar -->
        <header class="navbar navbar-expand border-bottom border-secondary border-opacity-25 sticky-top px-3 px-lg-4"
                style="background: rgba(6, 9, 19, 0.85); backdrop-filter: blur(12px); z-index: 1030;">

            <!-- Mobile Drawer Toggle -->
            <button class="btn btn-outline-secondary btn-sm d-lg-none me-3" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarOffcanvas">
                <i class="bi bi-list fs-5"></i>
            </button>

            <!-- Search Field -->
            <div class="d-none d-md-flex align-items-center w-50" role="search">
                <div class="input-group input-group-sm rounded-pill overflow-hidden border border-secondary border-opacity-25" style="background: rgba(4, 7, 17, 0.7);">
                    <span class="input-group-text bg-transparent border-0 text-secondary ps-3">
                        <i class="bi bi-search"></i>
                    </span>
                    <input id="desktopSearch" class="form-control bg-transparent border-0 text-white font-mono small" type="search" placeholder="Search encrypted files, folders, or hashes..." onkeyup="filterDashboardTable(this.value)">
                </div>
            </div>

            <!-- Right Header Actions -->
            <div class="d-flex align-items-center ms-auto gap-3">

                <!-- Notifications Link -->
                <a href="{% url 'notification' %}" class="nav-link text-secondary position-relative p-1" title="Notifications">
                    <i class="bi bi-bell-fill fs-5 text-info"></i>
                    <span class="position-absolute top-0 start-100 translate-middle p-1 bg-info border border-dark rounded-circle" style="width: 8px; height: 8px;"></span>
                </a>

                <!-- User Dropdown Menu -->
                <div class="dropdown">
                    <a class="btn btn-sm d-flex align-items-center gap-2 border border-secondary border-opacity-25 rounded-pill px-3 py-1.5 bg-black bg-opacity-50 text-light"
                       href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        {% if request.user.profile_picture %}
                          <img src="{{ request.user.profile_picture.url }}" class="rounded-circle" style="width: 22px; height: 22px; object-fit: cover;">
                        {% else %}
                          <i class="bi bi-person-circle text-info fs-5"></i>
                        {% endif %}
                        <span class="d-none d-sm-inline font-mono small">{{ request.user.full_name|default:request.user.email }}</span>
                    </a>

                    <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end shadow-lg border border-secondary border-opacity-25 mt-2">
                        <li class="px-3 py-2 border-bottom border-secondary border-opacity-25">
                            <strong class="text-white font-mono small d-block">{{ request.user.full_name|default:request.user.username }}</strong>
                            <small class="text-secondary font-mono" style="font-size: 0.72rem;">{{ request.user.email }}</small>
                        </li>
                        <li>
                            <a class="dropdown-item py-2" href="{% url 'profile' %}">
                                <i class="bi bi-person me-2 text-info"></i>My Profile
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item py-2" href="{% url 'edit_profile' %}">
                                <i class="bi bi-gear me-2 text-info"></i>Settings &amp; Security
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item py-2" href="{% url 'change_password' %}">
                                <i class="bi bi-key me-2 text-info"></i>Change Password
                            </a>
                        </li>
                        <li><hr class="dropdown-divider border-secondary border-opacity-25"></li>
                        <li>
                            <a class="dropdown-item py-2 text-danger" href="{% url 'logout' %}">
                                <i class="bi bi-box-arrow-right me-2"></i>Sign Out
                            </a>
                        </li>
                    </ul>
                </div>

            </div>
        </header>

        <!-- Django Messages Container -->
        <div class="container-fluid px-3 px-lg-4 mt-3">
            {% if messages %}
                {% for message in messages %}
                    <div class="alert alert-{{ message.tags|default:'info' }} alert-dismissible fade show rounded-3 border border-secondary border-opacity-25 font-mono small d-flex align-items-center gap-2" role="alert" style="background: rgba(11, 17, 32, 0.95); color: #f8fafc;">
                        <i class="bi bi-info-circle-fill text-info fs-5"></i>
                        <div>{{ message }}</div>
                        <button class="btn-close btn-close-white ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endfor %}
            {% endif %}
        </div>

        <!-- Main Body Workspace -->
        <main id="main-content" class="container-fluid p-3 p-lg-4 flex-grow-1">
            {% block content %}{% endblock %}
        </main>

    </div>

</div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    if (typeof AOS !== 'undefined') {
      AOS.init({ duration: 600, once: true });
    }
  });

  /* Search Filter Helper */
  function filterDashboardTable(query) {
    const term = query.toLowerCase().trim();
    const rows = document.querySelectorAll('table tbody tr');
    rows.forEach(row => {
      const text = row.textContent.toLowerCase();
      if (!term || text.includes(term)) {
        row.style.display = '';
      } else {
        row.style.display = 'none';
      }
    });
  }
</script>

{% block extra_js %}{% endblock %}

</body>
</html>
